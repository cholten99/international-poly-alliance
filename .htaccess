# Deny access to dotfiles (.env, .git*, .htpasswd, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny access to the .git directory and its contents
RedirectMatch 404 "^/\.git($|/)"

# Deny access to common secret/backup/data file types
<FilesMatch "\.(env|log|bak|old|swp|sqlite3?|db|pem|key)$">
    Require all denied
</FilesMatch>

# This is a static site edited directly and expected to change often --
# don't let browsers/CDN cache HTML so edits show up immediately.
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
